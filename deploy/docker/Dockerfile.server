# Aegis control plane: HTTP API + gRPC agent transport + metrics.
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
# One COPY per directory: multi-token COPY lines are parsed as N sources +
# ONE destination (last token), NOT as src->dest pairs — the merged line
# previously dumped cmd/, internal/ and api/ into migrations/ and broke
# `go build ./cmd/server` with "stat /src/cmd/server: directory not found".
COPY cmd/ cmd/
COPY internal/ internal/
COPY api/ api/
COPY migrations/ migrations/
# Stamp the release version: `make docker` and the compose file pass
# AEGIS_VERSION (git describe); plain builds report "dev".
ARG AEGIS_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${AEGIS_VERSION}" \
    -o /out/aegis-server ./cmd/server

FROM alpine:3.24
# wget is used by the Compose health check against /healthz.
RUN apk add --no-cache ca-certificates wget && addgroup -g 10001 aegis && adduser -u 10001 -G aegis -D -H aegis
COPY --from=build /out/aegis-server /usr/local/bin/aegis-server
USER 10001
EXPOSE 8080 9090 9091
ENTRYPOINT ["aegis-server"]
