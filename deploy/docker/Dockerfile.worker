# Aegis async worker: NATS consumer — detection evaluation, vulnerability
# correlation, report generation and fan-out jobs.
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY api/ api/
COPY migrations/ migrations/
ARG AEGIS_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${AEGIS_VERSION}" \
    -o /out/aegis-worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && addgroup -g 10001 aegis && adduser -u 10001 -G aegis -D -H aegis
COPY --from=build /out/aegis-worker /usr/local/bin/aegis-worker
USER 10001
ENTRYPOINT ["aegis-worker"]
