# Endpoint agent. Ship the raw binary for windows/darwin deployments:
#   CGO_ENABLED=0 GOOS=windows go build -o aegis-agent.exe ./cmd/agent
#   CGO_ENABLED=0 GOOS=darwin  go build -o aegis-agent     ./cmd/agent
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY api/ api/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/aegis-agent ./cmd/agent

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && addgroup -g 10001 aegis && adduser -u 10001 -G aegis -D -H aegis
COPY --from=build /out/aegis-agent /usr/local/bin/aegis-agent
USER 10001
ENTRYPOINT ["aegis-agent"]
