# Aegis feed worker: scheduled KEV/EPSS/NVD/OSV ingestion into the
# vulnerability store.
# syntax=docker/dockerfile:1
FROM golang:1.27-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY api/ api/
COPY migrations/ migrations/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/aegis-feed-worker ./cmd/feed-worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && addgroup -g 10001 aegis && adduser -u 10001 -G aegis -D -H aegis
COPY --from=build /out/aegis-feed-worker /usr/local/bin/aegis-feed-worker
USER 10001
ENTRYPOINT ["aegis-feed-worker"]
