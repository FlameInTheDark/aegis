# ==============================================================================
# Aegis Security Platform - example environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ==============================================================================

# --- Core ---
AEGIS_ENV=development
AEGIS_LOG_LEVEL=info
AEGIS_LOG_FORMAT=console
AEGIS_HTTP_ADDR=:8080
AEGIS_GRPC_ADDR=:9090
AEGIS_METRICS_ADDR=:9091

# --- Public URL of the web UI (used for CORS / links) ---
AEGIS_PUBLIC_URL=http://localhost:5173

# --- External connections (aegis.connector.v1) ---
# Endpoint embedded into UI connect commands
# (aegis-connector --connect <addr>/<one-time-token>). Must be reachable
# FROM the components themselves: with the compose stack publishing the
# server's 9090, "localhost:9090" works for connectors on the compose host;
# for agents/scanners joining from other machines set the host's DNS name
# or LAN IP here (e.g. aegis.example.com:9090).
AEGIS_CONNECTOR_PUBLIC_ADDR=localhost:9090
# One-time enrollment token validity (create/reconnect in the UI).
AEGIS_CONNECTOR_TOKEN_TTL=24h

# --- PostgreSQL ---
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- ClickHouse ---
CLICKHOUSE_URL=clickhouse://localhost:9000?database=aegis

# --- Object storage (any S3-compatible endpoint) ---
# Host port 9001 = RustFS S3 API (compose maps it there; host 9000 is the
# ClickHouse native port). Container-internal deployments use http://rustfs:9000.
S3_ENDPOINT=http://localhost:9001
S3_BUCKET=aegis
S3_ACCESS_KEY=aegis
S3_SECRET_KEY=aegis-secret-change-me
S3_USE_SSL=false

# --- Auth ---
# Generate with: openssl rand -base64 48
AEGIS_JWT_SECRET=change-me-generate-a-long-random-secret
# Secure flag for the HttpOnly refresh cookie (defaults to true when
# AEGIS_ENV=production). Set to false ONLY for plain-HTTP local/demo runs.
AEGIS_AUTH_COOKIE_SECURE=false
AEGIS_ACCESS_TOKEN_TTL=15m
AEGIS_REFRESH_TOKEN_TTL=720h
# Password requirements: at least 12 chars at runtime.
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@aegis.local
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=change-me-12chars-min

# --- Agent CA (mTLS for endpoint agents) ---
# Paths to PEM files. Generate with scripts/gen-agent-ca.sh
AEGIS_AGENT_CA_CERT=./configs/pki/agent-ca.crt
AEGIS_AGENT_CA_KEY=./configs/pki/agent-ca.key

# --- TLS for the HTTP API (optional; terminate at proxy otherwise) ---
AEGIS_TLS_CERT=
AEGIS_TLS_KEY=

# --- Scanner binaries (paths inside the scanner container) ---
AEGIS_NMAP_PATH=/usr/bin/nmap
AEGIS_ZGRAB_PATH=/usr/local/bin/zgrab2
AEGIS_NUCLEI_PATH=/usr/local/bin/nuclei
AEGIS_MASSCAN_PATH=

# --- Scanner safety limits ---
AEGIS_SCAN_MAX_CONCURRENCY=4
AEGIS_SCAN_MAX_TARGETS=65536
AEGIS_SCAN_MAX_PACKET_RATE=500
AEGIS_SCAN_MAX_RUNTIME=4h
AEGIS_SCAN_ALLOW_PUBLIC_SCOPES=false

# --- Feeds ---
# Selection / kill switch for heavy bootstraps (cvelistv5 ships a ~350 MB
# archive on first run). Feeds run concurrently; one slow source never
# blocks the others.
AEGIS_FEEDS_ENABLED=nvd,kev,epss,cvelistv5
AEGIS_FEEDS_INTERVAL=6h
# Optional NVD API key (request: https://data.nist.gov) — 50 req/30s instead
# of 5, first full sync in minutes instead of ~half an hour.
AEGIS_NVD_API_KEY=

# --- Telemetry (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
AEGIS_TRACES_SAMPLE_RATIO=0.05

# --- Demo mode: seeds a realistic synthetic dataset on first boot ---
AEGIS_DEMO_MODE=true

# Version stamp baked into locally built images. `make docker` passes
# `git describe` automatically; plain `docker compose build` defaults to dev.
# AEGIS_VERSION=v1.6.0
