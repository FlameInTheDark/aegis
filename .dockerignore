# Build-context hygiene. All service images build from the repo root:
#   docker compose -f deploy/compose/docker-compose.yml build
# Go stages copy cmd/ internal/ api/ migrations/; the frontend stage runs
# `npm ci` inside the image and then copies web/ — host node_modules/dist
# MUST never enter the context or the Linux build breaks (Windows binaries
# for esbuild/rollup overwrite the container-native ones).
.git
.gitignore
.dockerignore
.env
.env.*

# Local build artifacts
bin/
dist/
coverage.txt
*.exe
*.test
*.out

# Frontend local artifacts
web/node_modules/
web/dist/
web/*.tsbuildinfo

# Local data / secrets (never bake into images)
certs/
data/
volumes/

# Not needed by any image stage (keeps the context small; scripts/ holds
# the portable-postgres test binaries)
docs/
scripts/
testdata/
deploy/helm/
deploy/kubernetes/
